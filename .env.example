# GuideGo Android App - Environment Configuration
# Copy các giá trị này vào file local.properties (KHÔNG commit local.properties lên git)

# API Base URL
# - Android Emulator: http://10.0.2.2:{PORT}/api/
# - Thiết bị thật (cùng WiFi): http://{IP_MÁY_TÍNH}:{PORT}/api/
# - Ví dụ ASP.NET Core port 5000:
BASE_URL=http://10.0.2.2:5000/api/

# ========================
# Cách thêm vào local.properties:
# 1. Mở file local.properties ở thư mục gốc project
# 2. Thêm dòng: BASE_URL=http://10.0.2.2:5000/api/
# 3. Thay đổi port theo cấu hình server của bạn
# ========================

